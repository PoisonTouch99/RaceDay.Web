@model CategoryFormViewModel
@{ ViewData["Title"] = "Add Category"; }

<div class="page-header">
    <div class="container">
        <h2><i class="bi bi-tag me-2 text-warning"></i>Add Category — @Model.EventName</h2>
    </div>
</div>

<div class="container py-2">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="form-card">
                @if (Model.ErrorMessage is not null)
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form asp-action="CreateCategory" method="post">
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="EventName" />
                    <div class="mb-3">
                        <label class="form-label">Category Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Senior Men, Under 20, 10km" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category Type *</label>
                        <select asp-for="CategoryType" class="form-select" id="catType"
                                onchange="toggleFields()">
                            <option value="Age">Age</option>
                            <option value="Distance">Distance</option>
                        </select>
                    </div>
                    <div id="ageFields">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label">Min Age</label>
                                <input asp-for="MinAge" type="number" min="0" class="form-control" placeholder="e.g. 18" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Max Age</label>
                                <input asp-for="MaxAge" type="number" min="0" class="form-control" placeholder="e.g. 39" />
                            </div>
                        </div>
                    </div>
                    <div id="distFields" style="display:none">
                        <div class="mb-3">
                            <label class="form-label">Distance (km)</label>
                            <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" placeholder="e.g. 10" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Max Participants</label>
                            <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Entry Fee (R)</label>
                            <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" placeholder="150.00" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-raceday">
                            <i class="bi bi-plus-lg me-1"></i>Add Category
                        </button>
                        <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleFields() {
    var t = document.getElementById('catType').value;
    document.getElementById('ageFields').style.display  = t === 'Age'      ? '' : 'none';
    document.getElementById('distFields').style.display = t === 'Distance' ? '' : 'none';
}
</script>
}
