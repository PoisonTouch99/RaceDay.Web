@model List<CategoryResponse>
@{ ViewData["Title"] = "Categories"; var ev = ViewBag.Event as EventResponse; }

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="bi bi-tag me-2 text-warning"></i>Categories</h2>
            <p class="text-muted mb-0 small">@ev?.Name</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateCategory" asp-route-eventId="@ev?.EventId" class="btn btn-raceday">
                <i class="bi bi-plus-lg me-1"></i>Add Category
            </a>
            <a asp-action="Events" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-tags display-3 d-block mb-3"></i>
            <p>No categories yet. Add one to allow participants to enrol.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <table class="table raceday-table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Details</th>
                        <th>Entry Fee</th>
                        <th>Capacity</th>
                        <th>Enrolled</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cat.Name</td>
                            <td><span class="badge bg-secondary">@cat.CategoryType</span></td>
                            <td class="text-muted small">
                                @if (cat.CategoryType == "Distance") { <span>@cat.DistanceKm km</span> }
                                else { <span>Age @cat.MinAge–@cat.MaxAge</span> }
                            </td>
                            <td>R @cat.EntryFee.ToString("N2")</td>
                            <td>@cat.MaxParticipants</td>
                            <td>
                                <span class="badge @(cat.EnrolledCount >= cat.MaxParticipants ? "bg-danger" : "bg-success")">
                                    @cat.EnrolledCount / @cat.MaxParticipants
                                </span>
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteCategory" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?')">
                                    <input type="hidden" name="id" value="@cat.CategoryId" />
                                    <input type="hidden" name="eventId" value="@ev?.EventId" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
