@model List<EventResponse>
@{ ViewData["Title"] = "Dashboard"; }

<div class="hero-banner">
    <div class="container">
        <h1><i class="bi bi-speedometer2 me-2 text-warning"></i>Organiser Dashboard</h1>
        <p class="text-white-50 mb-0">Welcome back, @ViewBag.UserName</p>
    </div>
</div>

<div class="container py-4">
    @{
        var total = Model.Count;
        var published = Model.Count(e => e.Status == "Published");
        var upcoming = Model.Count(e => e.EventDate > DateTime.Now && e.Status == "Published");
        var totalEnrolments = Model.Sum(e => e.Categories.Sum(c => c.EnrolledCount));
    }

    <!-- Stats row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center py-3">
                <div class="display-6 fw-bold text-warning">@total</div>
                <div class="text-muted small">Total Events</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center py-3">
                <div class="display-6 fw-bold text-success">@published</div>
                <div class="text-muted small">Published</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center py-3">
                <div class="display-6 fw-bold text-primary">@upcoming</div>
                <div class="text-muted small">Upcoming</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center py-3">
                <div class="display-6 fw-bold text-danger">@totalEnrolments</div>
                <div class="text-muted small">Total Enrolments</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">My Events</h4>
        <a asp-action="CreateEvent" class="btn btn-raceday">
            <i class="bi bi-plus-lg me-1"></i>New Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar-x display-3 d-block mb-3"></i>
            <p>You haven't created any events yet.</p>
            <a asp-action="CreateEvent" class="btn btn-raceday">Create your first event</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <table class="table raceday-table mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.OrderBy(e => e.EventDate))
                    {
                        var enrolCount = ev.Categories.Sum(c => c.EnrolledCount);
                        <tr>
                            <td class="fw-semibold">@ev.Name</td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td>
                                @{
                                    var icon = ev.EventType switch { "Run" => "person-running", "Cycle" => "bicycle", _ => "person-walking" };
                                    var cls  = ev.EventType switch { "Run" => "type-run", "Cycle" => "type-cycle", _ => "type-walk" };
                                }
                                <i class="bi bi-@icon @cls me-1"></i>@ev.EventType
                            </td>
                            <td>
                                <span class="badge status-@ev.Status.ToLower()">@ev.Status</span>
                            </td>
                            <td><span class="badge bg-secondary">@enrolCount</span></td>
                            <td class="text-end">
                                <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-secondary me-1" title="Enrolments">
                                    <i class="bi bi-people"></i>
                                </a>
                                <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary me-1" title="Results">
                                    <i class="bi bi-trophy"></i>
                                </a>
                                <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
