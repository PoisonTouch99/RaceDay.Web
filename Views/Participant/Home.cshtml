@model List<EventResponse>
@{ ViewData["Title"] = "Upcoming Events"; }

<div class="hero-banner">
    <div class="container">
        <h1><i class="bi bi-flag me-2 text-warning"></i>Upcoming Events</h1>
        <p class="text-white-50">Find your next race. Enter today.</p>
    </div>
</div>

<div class="container py-4">
    <!-- Filter bar -->
    <form asp-action="Home" method="get" class="card shadow-sm p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Location</label>
                <input type="text" name="location" value="@ViewBag.LocationFilter" class="form-control" placeholder="e.g. Johannesburg" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Event Type</label>
                <select name="eventType" class="form-select">
                    <option value="">All types</option>
                    <option value="Run"   selected="@(ViewBag.EventTypeFilter == "Run")">🏃 Run</option>
                    <option value="Walk"  selected="@(ViewBag.EventTypeFilter == "Walk")">🚶 Walk</option>
                    <option value="Cycle" selected="@(ViewBag.EventTypeFilter == "Cycle")">🚴 Cycle</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-raceday w-100">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.LocationFilter as string) || !string.IsNullOrEmpty(ViewBag.EventTypeFilter as string))
            {
                <div class="col-md-2">
                    <a asp-action="Home" class="btn btn-outline-secondary w-100">Clear</a>
                </div>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar-x display-3 d-block mb-3"></i>
            <p>No upcoming events found matching your filters.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model)
            {
                var icon = ev.EventType switch { "Run" => "person-running", "Cycle" => "bicycle", _ => "person-walking" };
                var cls  = ev.EventType switch { "Run" => "type-run", "Cycle" => "type-cycle", _ => "type-walk" };
                <div class="col-md-6 col-lg-4">
                    <div class="card event-card h-100">
                        <div class="position-relative" style="height:150px;background:linear-gradient(135deg,#1a1a2e,#0f3460);overflow:hidden">
                            @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                            {
                                <img src="@ev.BannerImageUrl" style="width:100%;height:100%;object-fit:cover" alt="" />
                                <div style="position:absolute;inset:0;background:rgba(0,0,0,.35)"></div>
                            }
                            <i class="bi bi-@icon @cls" style="position:absolute;bottom:12px;left:16px;font-size:2.5rem;opacity:.9"></i>
                            <span class="badge bg-warning text-dark" style="position:absolute;top:12px;right:12px">@ev.EventType</span>
                        </div>
                        <div class="card-body">
                            <h5 class="fw-bold mb-1">@ev.Name</h5>
                            <p class="text-muted small mb-1"><i class="bi bi-calendar3 me-1"></i>@ev.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@ev.Location</p>
                            @if (!string.IsNullOrEmpty(ev.Description))
                            {
                                <p class="small text-muted">@(ev.Description!.Length > 80 ? ev.Description[..80] + "…" : ev.Description)</p>
                            }
                            <p class="small mb-0"><i class="bi bi-tag me-1 text-warning"></i>
                                @ev.Categories.Count categor@(ev.Categories.Count == 1 ? "y" : "ies")
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pb-3">
                            <a asp-action="EventDetail" asp-route-id="@ev.EventId" class="btn btn-raceday w-100">
                                <i class="bi bi-eye me-1"></i>View & Enter
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
