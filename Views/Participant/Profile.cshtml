@model UpdateProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="page-header">
    <div class="container">
        <h2><i class="bi bi-person-circle me-2 text-warning"></i>My Profile</h2>
    </div>
</div>

<div class="container py-2">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                @if (Model.SuccessMessage is not null)
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</div>
                }
                @if (Model.ErrorMessage is not null)
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
                }
                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Full Name *</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. 0731112222" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Profile Picture <small class="text-muted">(optional, uploaded to Azure)</small></label>
                        <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                    </div>
                    <button type="submit" class="btn btn-raceday w-100">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
