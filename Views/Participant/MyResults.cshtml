@model List<ResultResponse>
@{ ViewData["Title"] = "My Results"; var totals = ViewBag.CategoryTotals as Dictionary<int,int> ?? new(); }

<div class="page-header">
    <div class="container">
        <h2><i class="bi bi-trophy me-2 text-warning"></i>My Results</h2>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-trophy display-3 d-block mb-3"></i>
            <p>No results recorded yet. Complete an event to see your times here.</p>
            <a asp-action="Home" class="btn btn-raceday">Browse Events</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                var totalFinishers = totals.TryGetValue(r.CategoryId, out var t) ? t : 0;
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center"
                             style="background:linear-gradient(135deg,#1a1a2e,#0f3460);color:#fff">
                            <span class="fw-bold">@r.EventName</span>
                            <span class="badge status-@r.Status.ToLower()">@r.Status</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-2">
                                <i class="bi bi-calendar3 me-1"></i>@r.RecordedAt.ToString("dd MMM yyyy")
                            </p>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-tag me-1"></i>@r.CategoryName
                            </p>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-upc me-1"></i>Bib: <strong>@r.BibNumber</strong>
                            </p>
                            @if (r.Status == "Finished")
                            {
                                <div class="text-center py-2 px-3 rounded mb-2" style="background:#f0f4ff">
                                    <div class="display-6 fw-bold text-primary">
                                        @r.FinishTime?.ToString(@"hh\:mm\:ss")
                                    </div>
                                    <small class="text-muted">Finish Time</small>
                                </div>
                                @if (r.Position.HasValue && totalFinishers > 0)
                                {
                                    <div class="text-center">
                                        <span class="fs-5 fw-semibold text-warning">
                                            @r.Position<sup>@(r.Position switch { 1=>"st", 2=>"nd", 3=>"rd", _=>"th" })</sup>
                                        </span>
                                        <span class="text-muted small"> out of @totalFinishers finishers</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-3">
                                    <span class="badge status-@r.Status.ToLower() fs-6 px-4 py-2">@r.Status</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
