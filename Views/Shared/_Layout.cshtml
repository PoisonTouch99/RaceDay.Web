<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " – RaceDay" : "RaceDay")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@{
    bool isAuth = ViewBag.IsAuthenticated == true;
    string role  = ViewBag.UserRole as string ?? "";
    string name  = ViewBag.UserName as string ?? "";
}

<nav class="navbar navbar-expand-lg navbar-dark raceday-nav">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <i class="bi bi-stopwatch-fill text-warning fs-4"></i> RaceDay
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto">
                @if (isAuth && role == "Organiser")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Organiser" asp-action="Events">
                            <i class="bi bi-calendar-event me-1"></i>My Events
                        </a>
                    </li>
                }
                @if (isAuth && role == "Participant")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Participant" asp-action="Home">
                            <i class="bi bi-house me-1"></i>Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">
                            <i class="bi bi-person-check me-1"></i>My Entries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                            <i class="bi bi-trophy me-1"></i>My Results
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (isAuth)
                {
                    @if (role == "Participant")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Profile">
                                <i class="bi bi-person-circle me-1"></i>@name
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link text-warning"><i class="bi bi-person-circle me-1"></i>@name</span>
                        </li>
                    }
                    <li class="nav-item">
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning ms-2">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-warning btn-sm ms-2 fw-semibold" asp-controller="Auth" asp-action="Register">Sign Up</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main>
    @if (TempData["Success"] is string success)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@err
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @RenderBody()
</main>

<footer class="raceday-footer mt-5 py-4">
    <div class="container text-center text-muted small">
        <i class="bi bi-stopwatch-fill text-warning me-1"></i>
        <strong>RaceDay</strong> &mdash; Race management platform &copy; @DateTime.Now.Year
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
