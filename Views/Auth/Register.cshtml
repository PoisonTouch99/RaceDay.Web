@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="hero-banner">
    <div class="container text-center">
        <i class="bi bi-person-plus-fill display-4 text-warning"></i>
        <h1 class="mt-2">Create your account</h1>
        <p class="text-white-50">Join RaceDay as an organiser or participant</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">
                <h4 class="mb-4 fw-bold">Sign up</h4>
                @if (Model.ErrorMessage is not null)
                {
                    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
                }
                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password <small class="text-muted">(min 8 characters)</small></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone <small class="text-muted">(optional)</small></label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. 0731112222" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">I am a…</label>
                        <div class="row g-3">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleParticipant" value="Participant" checked />
                                <label class="btn btn-outline-primary w-100 py-3" for="roleParticipant">
                                    <i class="bi bi-person-running d-block fs-3 mb-1"></i>
                                    Participant
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleOrganiser" value="Organiser" />
                                <label class="btn btn-outline-warning w-100 py-3" for="roleOrganiser">
                                    <i class="bi bi-clipboard-data d-block fs-3 mb-1"></i>
                                    Organiser
                                </label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-raceday btn-lg w-100">
                        <i class="bi bi-check-lg me-2"></i>Create Account
                    </button>
                </form>
                <hr class="my-4" />
                <p class="text-center text-muted mb-0">
                    Already have an account?
                    <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>
